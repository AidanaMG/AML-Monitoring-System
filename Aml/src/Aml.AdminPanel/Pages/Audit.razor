@page "/audit"
@attribute [Authorize(Roles = "Admin")]
@using Aml.AdminPanel.Models
@using Microsoft.AspNetCore.Authorization
@using Aml.AdminPanel.Services
@inject AuditLogsApi Api

<h3 class="mt-4"
    style="font-size: 1.5rem; font-weight: 700; color: #f1fff6; border-left: 4px solid #39ff88; padding-left: 0.75rem; margin-bottom: 1rem;">
    AUDIT LOGS
</h3>

<div class="mb-3 d-flex flex-wrap align-items-center gap-3">
    <div class="term-seg">
        <button class="@(usernameFilter == "" ? "on" : null)" @onclick='() => SetUsernameFilter("")'>All</button>
        <button class="@(usernameFilter == "ComplianceOfficer" ? "on" : null)" @onclick='() => SetUsernameFilter("ComplianceOfficer")'>Compliance Officer</button>
        <button class="@(usernameFilter == "Administrator" ? "on" : null)" @onclick='() => SetUsernameFilter("Administrator")'>Administrator</button>
    </div>

    <div class="term-seg">
        <button class="@(actionFilter == "" ? "on" : null)" @onclick='() => SetActionFilter("")'>All</button>
        <button class="@(actionFilter == "AlertTakenToReview" ? "on" : null)" @onclick='() => SetActionFilter("AlertTakenToReview")'>Alert Taken to Review</button>
        <button class="@(actionFilter == "AlertResolved" ? "on" : null)" @onclick='() => SetActionFilter("AlertResolved")'>Alert Resolved</button>
        <button class="@(actionFilter == "RuleUpdated" ? "on" : null)" @onclick='() => SetActionFilter("RuleUpdated")'>Rule Updated</button>
        <button class="@(actionFilter == "ScreeningRun" ? "on" : null)" @onclick='() => SetActionFilter("ScreeningRun")'>Screening Run</button>
    </div>

    <div class="term-seg">
        <button class="@(typeFilter == "" ? "on" : null)" @onclick='() => SetTypeFilter("")'>All</button>
        <button class="@(typeFilter == "Alert" ? "on" : null)" @onclick='() => SetTypeFilter("Alert")'>Alert</button>
        <button class="@(typeFilter == "Rule" ? "on" : null)" @onclick='() => SetTypeFilter("Rule")'>Rule</button>
        <button class="@(typeFilter == "Transaction" ? "on" : null)" @onclick='() => SetTypeFilter("Transaction")'>Transaction</button>
    </div>
</div>



@if (error is not null)
{
    <p style="color: #ff6b6b; background: rgba(255, 107, 107, 0.1); border: 1px solid rgba(255, 107, 107, 0.35); border-radius: 8px; padding: 0.6rem 1rem;">@error</p>
}
else if (data is null)
{
    <p style="font-family: 'Cascadia Code', Consolas, monospace; font-size: 1rem; color: #39ff88; text-shadow: 0 0 14px rgba(57, 255, 136, 0.5)">LOADING...</p>
}
else if (Filtered.Length == 0)
{
    <p style="font-family: 'Cascadia Code', Consolas, monospace; font-size: 1rem; color: #6b8f78;">THERE ARE NO LOGS</p>
}
else
{
    <div style="background-color: #0f1712; border: 1px solid #1f3a28; border-radius: 10px; overflow-x: auto;
        box-shadow: 0 0 20px rgba(57, 255, 136, 0.08); font-family: 'Cascadia Code', Consolas, monospace;">
        <table class="table table-hover term-table mb-0">
            <thead>
                <tr>
                    <th>Id</th>
                    <th>Username</th>
                    <th>Action</th>
                    <th>Type</th>
                    <th>Id</th>
                    <th>Old</th>
                    <th>New</th>
                    <th>Created At</th>
                </tr>
            </thead>

            <tbody>
                @foreach (var log in PagedLogs)
                {
                    <tr>
                        <td style="color: #6b8f78;">@log.Id</td>
                        <td style="color: @UserColor(log.UserName); font-weight: 700;">@log.UserName</td>
                        <td>
                            <span style="color: @ActionColor(log.Action); border: 1px solid @ActionColor(log.Action);
                                border-radius: 6px; padding: 0.1rem 0.55rem; font-size: 0.75rem; font-weight: 700; letter-spacing: 1px;">
                                @log.Action
                            </span>
                        </td>
                        <td style="color: #6b8f78;">@log.EntityType</td>
                        <td style="color: #6b8f78;">@log.EntityId</td>
                        <td style="color: #6b8f78; min-width: 120px; white-space: pre-wrap;">@log.OldValue</td>
                        <td style="color: #6b8f78; min-width: 200px; white-space: pre-wrap;">@log.NewValue</td>
                        <td style="color: #6b8f78;">@log.CreatedAt.ToString("dd.MM.yyyy HH:mm")</td>
                    </tr>
                }
            </tbody>

        </table>
    </div>

    <div class="mt-3" style="font-family: 'Cascadia Code', Consolas, monospace;">
        <button class="btn btn-sm term-btn" disabled="@(currentPage <= 1)"
                @onclick="PreviousPage">
            &lt; BACK
        </button>

        <span class="mx-2" style="color: #6b8f78; font-size: 0.85rem; letter-spacing: 1px;">PAGE @currentPage / @totalPages</span>

        <button class="btn btn-sm term-btn" disabled="@(currentPage >= totalPages)"
                @onclick="NextPage">
            NEXT &gt;
        </button>
    </div>

}


@code
{
    private AuditListResponse? data;
    private string? error;
    private int currentPage = 1;
    private const int PageSize = 5;

    private string usernameFilter = "";
    private string actionFilter = "";
    private string typeFilter = "";


    private int totalPages => Math.Max(1, (int)Math.Ceiling(Filtered.Length / (double)PageSize));

    protected override async Task OnInitializedAsync() => await LoadAsync();

    private async Task LoadAsync()
    {
        error = null;
        data = null;

        try
        {
            data = await Api.GetListAsync(1, 1000);
        }
        catch (Exception ex)
        {
            error = ex.Message;
        }
    }


    private AuditLogItem[] Filtered =>
        data is null ? Array.Empty<AuditLogItem>() : data.Items
        .Where(l => usernameFilter == "" || l.UserName == usernameFilter)
        .Where(l => actionFilter == "" || l.Action == actionFilter)
        .Where(l => typeFilter == "" || l.EntityType == typeFilter)
        .ToArray();

    private AuditLogItem[] PagedLogs =>
        Filtered.Skip((currentPage - 1) * PageSize).Take(PageSize).ToArray();

    private void SetUsernameFilter(string value)
    {
        usernameFilter = value;
        
        currentPage = 1;
    }

    private void SetActionFilter(string value)
    {
        actionFilter = value;

        currentPage = 1;
    }

    private void SetTypeFilter(string value)
    {
        typeFilter = value;

        currentPage = 1;
    }

    private async Task NextPage()
    {
        currentPage++;
    }

    private async Task PreviousPage()
    {
        currentPage--;
    }

    
    private static string ActionColor(string? action) => action?.ToLowerInvariant() switch
    {
        "alertresolved" => "#39ff88",
        "alerttakentoreview" => "#ff9f3a",
        "ruleupdated" => "#b47aff",
        "screeningrun" => "#4fd6d6",
        _ => "#d7f5e0"
    };

    private static string UserColor(string? user) => user?.ToLowerInvariant() switch
    {
        "complianceofficer" => "#ffd24d",
        "administrator" => "#7aa5ff",
        _ => "#d7f5e0"
    };
}

