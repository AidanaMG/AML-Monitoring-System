@using Microsoft.AspNetCore.Components.Authorization
@using Aml.AdminPanel.Services
@inject NavigationManager Navigation
@inject JwtAuthStateProvider AuthProvider
@inject TokenStorage Tokens
@inject AlertsFilterState State
@inherits LayoutComponentBase

<div class="page">
    <AuthorizeView>
        <Authorized>
            <div class="sidebar" style="background-image: none; background-color: #070b08; border-right: 1px solid #1f3a28;
                display: flex; flex-direction: column;">
                <NavMenu />
                <div style="margin-top: auto; padding: 1rem; border-top: 1px solid #1f3a28;
                    font-family: 'Cascadia Code', Consolas, monospace;">
                    <div style="font-size: 0.7rem; letter-spacing: 1.5px; color: #6b8f78; margin-bottom: 0.25rem;">SIGNED IN AS</div>
                    <div style="color: #39ff88; font-weight: 600; margin-bottom: 0.75rem; word-break: break-all;">
                        @context.User.Identity!.Name
                    </div>
                    <button class="btn btn-sm w-100 logout-btn" @onclick="LogoutAsync">
                        LOGOUT
                    </button>
                </div>
            </div>
        </Authorized>
    </AuthorizeView>

    <main>
        <article class="content px-4">
            @Body
        </article>
    </main>
</div>

@code
{
    private async Task LogoutAsync()
    {
        await Tokens.RemoveAsync();
        AuthProvider.NotifyUserLogout();
        State.SelectedStatuses.Clear();
        State.CurrentPage = 1;
        Navigation.NavigateTo("login");

    }
}