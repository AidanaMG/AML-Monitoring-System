@page "/alerts"
@attribute [Authorize]
@using Aml.AdminPanel.Models
@using Aml.AdminPanel.Services
@using Microsoft.AspNetCore.Authorization
@inject NavigationManager Navigation
@inject AlertsApi Api
@inject AlertsFilterState State

<h3 class="mt-4"
    style="font-size: 1.5rem; font-weight: 700; color: #f1fff6; border-left: 4px solid #39ff88; padding-left: 0.75rem; margin-bottom: 1rem;">
    ALERTS
</h3>

<div class="mb-3 d-flex flex-wrap align-items-center gap-2">
    @foreach(var s in statuses)
    {
        var on = selectedStatuses.Contains(s.Value);
        <label class="term-check" style="color: @(on ? StatusColor(s.Value) : "#6b8f78"); border-color: @(on ? StatusColor(s.Value) : "#1f3a28");">
            <input type="checkbox" checked="@on"
                @onchange="() => ToggleStatus(s.Value)"/> @s.Label
        </label>
    }
</div>

@if(error is not null)
{
    <p style="color: #ff6b6b; background: rgba(255, 107, 107, 0.1); border: 1px solid rgba(255, 107, 107, 0.35); border-radius: 8px; padding: 0.6rem 1rem;">@error</p>
}
else if(data is null)
{
    <p style="font-family: 'Cascadia Code', Consolas, monospace; font-size: 1rem; color: #39ff88; text-shadow: 0 0 14px rgba(57, 255, 136, 0.5)">LOADING...</p>
}
else if(data.Items.Length == 0)
{
    <p style="font-family: 'Cascadia Code', Consolas, monospace; font-size: 1rem; color: #6b8f78;">THERE ARE NO ALERTS</p>
}
else
{
    <div style="background-color: #0f1712; border: 1px solid #1f3a28; border-radius: 10px; overflow: hidden;
        box-shadow: 0 0 20px rgba(57, 255, 136, 0.08); font-family: 'Cascadia Code', Consolas, monospace;">

        <table class="table table-hover term-table mb-0">
            <thead>
                <tr>
                    <th>Client Id</th>
                    <th>Rule [Primary Trigger]</th>
                    <th>Risk Score</th>
                    <th>Status</th>
                    <th>Created At</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var alert in data.Items)
                {
                    <tr style="cursor: pointer" @onclick="() => OpenAlert(alert.Id)">
                        <td>@alert.ClientId</td>
                        <td>@alert.PrimaryTrigger</td>
                        <td>
                            <span style="color: @ScoreColor(alert.RiskScore); font-weight: 700; text-shadow: 0 0 10px @ScoreColor(alert.RiskScore)80;">
                                @alert.RiskScore
                            </span>
                        </td>
                        <td>
                            <span style="color: @StatusColor(alert.Status); border: 1px solid @StatusColor(alert.Status);
                                         border-radius: 6px; padding: 0.1rem 0.55rem; font-size: 0.75rem; font-weight: 700; letter-spacing: 1px;">
                                @alert.Status.ToUpperInvariant()
                            </span>
                        </td>
                        <td style="color: #6b8f78;">@alert.CreatedAt.ToString("dd.MM.yyyy HH:mm:ss")</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    
    <div class="mt-3" style="font-family: 'Cascadia Code', Consolas, monospace;">
        <button class="btn btn-sm term-btn" disabled="@(currentPage <= 1)"
                @onclick="PreviousPage">
            &lt; BACK
        </button>

        <span class="mx-2" style="color: #6b8f78; font-size: 0.85rem; letter-spacing: 1px;">PAGE @currentPage / @totalPages</span>

        <button class="btn btn-sm term-btn" disabled="@(currentPage >= totalPages)"
                @onclick="NextPage">
            NEXT &gt;
        </button>
    </div>

}

@code
{
    private AlertListResponse? data;
    private string? error;
    private const int PageSize = 5;

    private int totalPages => data is null ? 1 : (int)Math.Ceiling(data.Total / (double)PageSize);

    protected override async Task OnInitializedAsync() => await LoadAsync();

    private async Task LoadAsync()
    {
        error = null;
        data = null;

        try
        {
            data = await Api.GetListAsync(selectedStatuses, currentPage, PageSize);
        }
        catch (Exception ex)
        {
            error = ex.Message;
        }
    }

    private static readonly (string Value, string Label)[] statuses =
    {
        ("New", "New"),
        ("UnderReview", "Under Review"),
        ("Blocked", "Blocked"),
        ("FalsePositive", "False Positive"),
    };

    private async Task ToggleStatus(string value)
    {
        if (!selectedStatuses.Remove(value)) selectedStatuses.Add(value);

        currentPage = 1;
        await LoadAsync();

    }

    private HashSet<string> selectedStatuses => State.SelectedStatuses;

    private int currentPage
    {
        get => State.CurrentPage;
        set => State.CurrentPage = value;
    }

    private async Task NextPage()
    {
        currentPage++;
        await LoadAsync();
    }

    private async Task PreviousPage()
    {
        currentPage--;
        await LoadAsync();
    }

    private static string StatusColor(string? status) => status switch
    {
        "New" => "#3aa0ff",
        "UnderReview" => "#ff9f3a",
        "Blocked" => "#ff4d6a",
        "FalsePositive" => "#39ff88",
        _ => "#d7f5e0"
    };

    private static string ScoreColor(decimal score) => score switch
    {
        >= 90 => "#ff4d6a",
        _ => "#ff9f3a"

    };

    private void OpenAlert(int id) => Navigation.NavigateTo($"/alerts/{id}");
}