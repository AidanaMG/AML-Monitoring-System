@page "/login"
@using System.Net.Http.Json
@using Aml.AdminPanel.Services
@inject HttpClient Http
@inject TokenStorage Tokens
@inject JwtAuthStateProvider AuthProvider
@inject NavigationManager Navigation

<h1 style="font-family:'Cascadia Code', Consolas, monospace; font-weight: 700; font-size: 1.9rem; color: #d7f5e0; text-align: center; 
margin: 12vh 0 1.5rem;">
    <span style="color: #39ff88;">&gt;</span> Log In
</h1>

<div style="max-width: 360px; margin: 0 auto; padding: 1.75rem; background-color: #0f1712; border: 1px solid #1f3a28;
    border-top: 3px solid #39ff88; border-radius: 10px; box-shadow: 0 0 30px rgba(57, 255, 136, 0.08); font-family:'Cascadia Code', Consolas, monospace;">
    <div class="mb-3">
        <label class="form-label" style="font-size: 0.75rem; letter-spacing: 1.5px; color: #6b8f78;">USERNAME</label>
        <input class="form-control login-input" autocomplete="username" placeholder="username" @bind:event="oninput" @bind="userName" @onkeydown="OnKeyDown"/>
    </div>    

    <div class="mb-3">
        <label class="form-label" style="font-size: 0.75rem; letter-spacing: 1.5px; color: #6b8f78;">PASSWORD</label>
        <input class="form-control login-input" type="password" autocomplete="current-password" placeholder="password" 
               @bind:event="oninput" @bind="password" @onkeydown="OnKeyDown" />
    </div>

    @if(error is not null)
    {
        <div style="color: #ff6b6b; background: rgba(255, 107, 107, 0.1); border: 1px solid rgba(255, 107, 107, 0.35);
                    border-radius: 8px; padding: 0.6rem 1rem; font-size: 0.85rem; margin-bottom: 1rem;">@error</div>
    }

    <button class="btn w-100 login-btn" @onclick="SubmitAsync" disabled="@isBusy">
        @(isBusy ? "Logging in..." : "LOGIN")
    </button>
</div>

@code
{
    private string userName = "";
    private string password = "";
    private string? error;
    private bool isBusy;

    [SupplyParameterFromQuery]
    public string? ReturnUrl { get; set; }

    private async Task SubmitAsync()
    {
        error = null;
        isBusy = true;

        try
        {
            var response = await Http.PostAsJsonAsync("api/auth/login", new { userName, password });

            if(!response.IsSuccessStatusCode)
            {
                error = "Incorrect login or password";
                return;
            }

            var result = await response.Content.ReadFromJsonAsync<LoginResponse>();

            await Tokens.SetAsync(result!.Token);
            await AuthProvider.NotifyUserAuthenticationAsync();

            Navigation.NavigateTo(string.IsNullOrEmpty(ReturnUrl) ? "/" : ReturnUrl);

        }
        catch(Exception ex)
        {
            error = $"Connection error: {ex.Message}";
        }
        finally
        {
            isBusy = false;
        }
    }

    private record LoginResponse(string Token, string UserName, string Role);

    private async Task OnKeyDown(KeyboardEventArgs e)
    {
        if(e.Key == "Enter" && !isBusy)
        {
            await SubmitAsync();
        }
    }
}


