@page "/rules"
@attribute [Authorize]
@using Aml.AdminPanel.Models
@using Microsoft.AspNetCore.Authorization
@using Aml.AdminPanel.Services
@using Microsoft.AspNetCore.Components.Authorization
@inject RulesApi Api


<h3 class="mt-4"
    style="font-size: 1.5rem; font-weight: 700; color: #f1fff6; border-left: 4px solid #39ff88; padding-left: 0.75rem; margin-bottom: 1rem;">
    RULES
</h3>


<div class="mb-3 d-flex flex-wrap align-items-center gap-3">
    <div class="term-seg">
        <button class="@(activeFilter == "" ? "on" : null)" @onclick='() => activeFilter = ""'>All</button>
        <button class="@(activeFilter == "true" ? "on" : null)" @onclick='() => activeFilter = "true"'>Active</button>
        <button class="@(activeFilter == "false" ? "on" : null)" @onclick='() => activeFilter = "false"'>Inactive</button>
    </div>

    <div class="term-seg">
        <button class="@(typeFilter == "" ? "on" : null)" @onclick='() => typeFilter = ""'>All</button>
        <button class="@(typeFilter == "Hard" ? "on" : null)" @onclick='() => typeFilter = "Hard"'>Hard</button>
        <button class="@(typeFilter == "Typology" ? "on" : null)" @onclick='() => typeFilter = "Typology"'>Typology</button>
        <button class="@(typeFilter == "Scoring" ? "on" : null)" @onclick='() => typeFilter = "Scoring"'>Scoring</button>
    </div>
</div>


@if (error is not null)
{
    <p style="color: #ff6b6b; background: rgba(255, 107, 107, 0.1); border: 1px solid rgba(255, 107, 107, 0.35); border-radius: 8px; padding: 0.6rem 1rem;">@error</p>

}
else if (data is null)
{
    <p style="font-family: 'Cascadia Code', Consolas, monospace; font-size: 1rem; color: #39ff88; text-shadow: 0 0 14px rgba(57, 255, 136, 0.5)">LOADING...</p>

}
else if (FilteredRules.Length == 0)
{
    <p style="font-family: 'Cascadia Code', Consolas, monospace; font-size: 1rem; color: #6b8f78;">THERE ARE NO RULES</p>

}
else
{
    <div style="background-color: #0f1712; border: 1px solid #1f3a28; border-radius: 10px; overflow-x: auto;
        box-shadow: 0 0 20px rgba(57, 255, 136, 0.08); font-family: 'Cascadia Code', Consolas, monospace;">
        <table class="table table-hover term-table mb-0">
            <thead>
                <tr>
                    <th>Id</th>
                    <th>Rule Code</th>
                    <th>Type</th>
                    <th>Action</th>
                    <th>Details</th>
                    <th>Weight</th>
                    <th style="min-width: 120px;">Status</th>
                    <th>Created At</th>
                    <th></th>
                </tr>
            </thead>

            <tbody>
                @foreach (var rule in FilteredRules)
                {
                    <tr>
                        <td style="color: #6b8f78;">@rule.Id</td>
                        <td style="color: #f1fff6; font-weight: 700;">@rule.RuleCode</td>
                        <td>
                            <span style="color: @TypeColor(rule.Type); border: 1px solid @TypeColor(rule.Type);
                                border-radius: 6px; padding: 0.1rem 0.55rem; font-size: 0.75rem; font-weight: 700; letter-spacing: 1px;">
                                @rule.Type.ToString().ToUpperInvariant()
                            </span>
                        </td>
                        <td style="color: @ActionColor(rule.Action.ToString()); font-weight: 700;">@rule.Action</td>
                        <td style="color: #6b8f78;">@rule.Details</td>
                        <td style="color: #3aa0ff; font-weight: 700;">@rule.Weight</td>
                        <td style="white-space: nowrap; min-width: 120px;">
                            @if (rule.IsActive)
                            {
                                <span style="color: #39ff88; font-size: 0.75rem; font-weight: 700; letter-spacing: 1px;">● ACTIVE</span>
                            }
                            else
                            {
                                <span style="color: #6b8f78; font-size: 0.75rem; font-weight: 700; letter-spacing: 1px;">○ INACTIVE</span>
                            }
                        </td>
                        <td style="color: #6b8f78;">@rule.CreatedAt.ToString("dd.MM.yyyy HH:mm")</td>

                        <td>
                            @if(rule.Type.ToString() != "Hard")
                            {
                                <AuthorizeView Roles="Admin">
                                    <button class="btn btn-sm term-btn" @onclick="() => StartEdit(rule)">EDIT</button>
                                </AuthorizeView>
                            }
                        </td>
                    </tr>

                    @if (editingId == rule.Id)
                    {
                        <tr class="term-edit-row">
                            <td colspan="9" style="background-color: #0b0f0c; border-left: 3px solid #39ff88; padding: 1.25rem 1.5rem;">
                                <div class="mb-3" style="max-width: 200px;">
                                    <label class="form-label" style="font-size: 0.75rem; letter-spacing: 1.5px; color: #6b8f78;">WEIGHT</label>
                                    <input class="form-control login-input" type="number" @bind="editWeight" />
                                </div>                                

                                <div class="mb-3">
                                    <label class="form-label" style="font-size: 0.75rem; letter-spacing: 1.5px; color: #6b8f78;">PARAMETERS (JSON)</label>

                                    <div style="color: #3aa0ff; font-size: 0.8rem; word-break: break-all; margin-bottom: 0.4rem;">
                                        @original?.ParametersJson
                                    </div>

                                    <textarea class="form-control login-input" rows="8" @bind="editParameters"></textarea>
                                </div>

                                <div class="d-flex align-items-center gap-2 mb-3">
                                    <input class="term-check" type="checkbox" id="editActive" @bind="editIsActive" />
                                    <label for="editActive" style="color: #d7f5e0; cursor: pointer; margin: 0;">Active</label>
                                </div>

                                @if (editError is not null)
                                {
                                    <div style="color: #ff4d6a; background: rgba(255, 77, 106, 0.10); border: 1px solid rgba(255, 77, 106, 0.35);
                                        border-radius: 8px; padding: 0.6rem 1rem; margin-bottom: 1rem; max-width: 600px;">
                                        @editError
                                    </div>
                                }

                                <button class="btn term-btn-ok me-2" @onclick="AskSave" disabled="@isSaving">SAVE</button>
                                <button class="btn term-btn" @onclick="CancelEdit">CANCEL</button>
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>
}

@if (showConfirm)
{
    <div style="position: fixed; inset: 0; background-color: rgba(0, 0, 0, 0.65); z-index: 2000;
        display: flex; align-items: center; justify-content: center;"
         @onclick="ConfirmNo">

        <div style="width: 100%; max-width: 420px; margin: 1rem; background-color: #0f1712; border: 1px solid #1f3a28;
            border-top: 3px solid @confirmColor; border-radius: 10px; padding: 1.5rem;
            box-shadow: 0 0 40px rgba(0, 0, 0, 0.6); font-family: 'Cascadia Code', Consolas, monospace;"
             @onclick:stopPropagation="true">

            <div style="font-size: 0.75rem; letter-spacing: 1.5px; color: #6b8f78; margin-bottom: 0.5rem;">CONFIRM ACTION</div>
            <h5 style="font-weight: 700; color: @confirmColor; margin-bottom: 0.75rem;">
                <span>&gt;</span> @confirmTitle
            </h5>
            <p style="color: #d7f5e0; margin-bottom: 1.5rem;">@confirmText</p>

            <div class="d-flex justify-content-end gap-2">
                <button class="btn btn-sm term-btn" @onclick="ConfirmNo">CANCEL</button>
                <button class="btn btn-sm login-btn" style="border-radius: 6px; font-weight: 700;"
                        @onclick="ConfirmYesAsync">
                    YES, I'M SURE
                </button>
            </div>
        </div>
    </div>
}

@code
{
    private RuleListItem[]? data;
    private string? error;

    private int? editingId;
    private decimal editWeight;
    private string editParameters = "";
    private bool editIsActive;
    private string? editError;
    private bool isSaving;

    private RuleListItem? original;

    private string activeFilter = "";
    private string typeFilter = "";

    private bool showConfirm;
    private string confirmTitle = "";
    private string confirmText = "";
    private string confirmColor = "#39ff88";
    private Func<Task>? confirmAction;

    protected override async Task OnInitializedAsync() => await LoadAsync();

    private async Task LoadAsync()
    {
        error = null;
        data = null;

        try
        {
            data = await Api.GetListAsync(); 
        }
        catch (Exception ex)
        {
            error = ex.Message;
        }
    }


    private void StartEdit(RuleListItem rule)
    {
        original = rule;
        editingId = rule.Id;
        editWeight = rule.Weight;
        editParameters = rule.ParametersJson;
        editIsActive = rule.IsActive;
        editError = null;
    }


    private void CancelEdit() => editingId = null;


    private void AskSave()
    {
        var code = original!.RuleCode;

        if (original.IsActive && !editIsActive)
            Ask("Deactivate rule", $"Rule {code} will be deactivated and will stop triggering alerts. Save changes?", "#ff4d6a");
        else
            Ask("Save changes", $"Save changes to rule {code}?", "#39ff88");
    }

    private void Ask(string title, string text, string color)
    {
        confirmTitle = title;
        confirmText = text;
        confirmColor = color;
        confirmAction = SaveAsync;
        showConfirm = true;
    }

    private async Task ConfirmYesAsync()
    {
        showConfirm = false;

        if (confirmAction is not null)
        {
            await confirmAction();
        }
    }

    private void ConfirmNo() => showConfirm = false;

    private async Task SaveAsync()
    {
        editError = null;
        isSaving = true;

        try
        {
            var response = await Api.UpdateAsync(editingId!.Value,
                new UpdateRuleRequest(
                    editWeight != original!.Weight ? editWeight : null, 
                    editParameters != original!.ParametersJson ? editParameters : null, 
                    editIsActive != original!.IsActive ? editIsActive : null));

            if(!response.IsSuccessStatusCode)
            {
                editError = await response.Content.ReadAsStringAsync();
                return;
            }

            editingId = null;
            await LoadAsync();
        }
        catch(Exception ex)
        {
            editError = ex.Message;
        }
        finally
        {
            isSaving = false;
        }
    }


    private RuleListItem[] FilteredRules =>
        data is null ? Array.Empty<RuleListItem>()
        : data.Where(r => activeFilter == "" || r.IsActive == bool.Parse(activeFilter))
              .Where(r => typeFilter == "" || r.Type == typeFilter)
              .ToArray();


    private static string TypeColor(object? type) => type?.ToString() switch
    {
        "Hard" => "#ff4d6a",
        "Typology" => "#ff9f3a",
        "Scoring" => "#3aa0ff",
        _ => "#d7f5e0"
    };


    private static string ActionColor(string? action) => action?.ToLowerInvariant() switch
    {
        "block" => "#ff4d6a",
        "flag" => "#ff9f3a",
        _ => "#d7f5e0"
    };


    
}